PROJECT_NAME="MarketPulse"
ENVIRONMENT="development"
SECRET_KEY="insecure-dev-secret-key-change-in-production-marketpulse"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for zero-config local run, or use PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/marketpulse"
DATABASE_URL="sqlite+aiosqlite:///./marketpulse.db"

# Redis Configuration (Optional: system automatically falls back to in-memory cache if Redis is down)
REDIS_URL="redis://localhost:6379/0"

# Market Data Provider ("mock" or "yfinance")
DEFAULT_MARKET_PROVIDER="mock"

# AI Configuration ("mock", "gemini", "openai", "groq")
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
